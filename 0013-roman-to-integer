class Solution:
    def romanToInt(self, s: str) -> int:
        res = i = 0
        map = {"I": 1, "V": 5, "X": 10, "L": 50, "C": 100, "D": 500, "M": 1000}
        while i < len(s):
            if i < len(s) - 1 and map[s[i]] < map[s[i+1]]:
                res += (map[s[i+1]] - map[s[i]])
                i += 2
            else:
                res += map[s[i]]
                i += 1
        return res
