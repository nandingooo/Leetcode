class Solution:
    def threeSumClosest(self, nums: List[int], target: int) -> int: 
        res = maxsize
        nums.sort()
        N = len(nums)
        for i, num in enumerate(nums):
            if i > 0 and nums[i-1] == num:
                continue
            l = i + 1
            r = N - 1
            while l < r:
                cur = num + nums[l] + nums[r]
                if abs(cur - target) < abs(res - target):
                    res = cur
                if res == target:
                    return res
                if cur > target:
                    r -= 1
                else: 
                    l += 1

        return res
